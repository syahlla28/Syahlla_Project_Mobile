<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FBFD"
    android:padding="16dp">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/imgBackMessage"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_button"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Kembali"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/txtKontakTitle"
        app:layout_constraintBottom_toBottomOf="@id/txtKontakTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top Header Title -->
    <TextView
        android:id="@+id/txtKontakTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Kontak Darurat"
        android:textColor="#172554"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgBackMessage" />

    <TextView
        android:id="@+id/txtTambahKontak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Tambah"
        android:textColor="#2563EB"
        android:textSize="16sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/txtKontakTitle"
        app:layout_constraintBottom_toBottomOf="@id/txtKontakTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Input Nomor Telepon -->
    <EditText
        android:id="@+id/etPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_container"
        android:hint="Cari atau Input Nomor Telepon"
        android:inputType="phone"
        android:textColor="#172554"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtKontakTitle" />

    <!-- Filter ChipGroup -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/etPhone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTerbaru"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Terbaru"
            app:chipIconTint="#2563EB" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPenting"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Penting"
            app:chipIconTint="#2563EB" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipKeluarga"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keluarga"
            app:chipIconTint="#2563EB" />

    </com.google.android.material.chip.ChipGroup>

    <!-- ListView for Contacts -->
    <ListView
        android:id="@+id/listMessageItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        app:layout_constraintTop_toBottomOf="@id/chipGroupFilter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
